// Amber Forge
// Converted to Adco. See docs/ADCO.md for the format.

theme "Amber Forge" {
    dark: true

    colors {
        bg: gray(0.055)
        surface: gray(0.078)
        panel: gray(0.10)
        text: gray(0.94)
        muted: gray(0.55)
        accent: rgb(0.95, 0.60, 0.20)
        accent2: rgb(0.85, 0.35, 0.30)
        keyword: rgb(0.95, 0.55, 0.25)
        function: rgb(0.90, 0.75, 0.35)
        string: rgb(0.65, 0.85, 0.45)
        comment: rgb(0.50, 0.46, 0.40)
        cursor: rgb(0.98, 0.65, 0.20)
        selection: rgb(0.40, 0.28, 0.14)
        error: rgb(0.92, 0.30, 0.30)
        warning: rgb(0.95, 0.72, 0.25)
        success: rgb(0.55, 0.82, 0.40)
        lineHighlight: gray(0.035)
    }

    font {
        family: "JetBrains Mono"
        size: 12
    }
}
