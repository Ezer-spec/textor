// Lua Language Support
// Converted to Adco. See docs/ADCO.md for the format.

addon "Lua Language Support" {
    version: "1.0"
    author: "Textor Community"

    language "Lua" {
        extensions: [".lua"]

        keywords: [
            "and", "break", "do", "else", "elseif", "end",
            "false", "for", "function", "goto", "if", "in",
            "local", "nil", "not", "or", "repeat", "return",
            "then", "true", "until", "while", "self"
        ]

        builtins: [
            "print", "pairs", "ipairs", "next", "type", "tostring",
            "tonumber", "table", "string", "math", "io", "os",
            "coroutine", "require", "pcall", "xpcall", "error", "assert",
            "setmetatable", "getmetatable", "rawget", "rawset", "rawequal", "rawlen",
            "select", "unpack", "load", "loadfile", "dofile", "collectgarbage"
        ]

        completions: [
            "print", "pairs", "ipairs", "next", "type", "tostring",
            "tonumber", "table.insert", "table.remove", "table.sort", "table.concat", "string.format",
            "string.find", "string.match", "string.gmatch", "string.gsub", "string.sub", "string.len",
            "string.upper", "string.lower", "string.rep", "math.abs", "math.ceil", "math.floor",
            "math.sqrt", "math.max", "math.min", "math.random", "math.randomseed", "math.huge",
            "math.pi", "io.open", "io.close", "io.read", "io.write", "io.lines",
            "os.time", "os.clock", "os.date", "os.exit", "os.getenv", "coroutine.create",
            "coroutine.resume", "coroutine.yield", "coroutine.status", "require", "pcall", "xpcall",
            "error", "assert", "setmetatable", "getmetatable", "rawget", "rawset",
            "rawequal", "rawlen", "select", "unpack", "load", "loadfile",
            "dofile", "collectgarbage"
        ]

        strings: ["\"", "'"]
        comment {
            line: "--"
            block: ["--[[", "]]"]
        }

        colors {
            keyword: rgb(0.55, 0.65, 1.00)
            type: rgb(0.30, 0.85, 0.85)
            builtin: rgb(0.55, 0.85, 0.70)
        }
        icon {
            color: rgb(0.45, 0.55, 0.95)
            symbol: "lua"
            svg: "lua.svg"
        }
    }
}
